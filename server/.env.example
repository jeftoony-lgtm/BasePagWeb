# =====================================================================
#  LUZ SERENA · Configuración del servidor
#  Copiá este archivo como "server/.env" y completalo.
#  El .env NUNCA se sube a GitHub (ya está en .gitignore).
# =====================================================================

# Conexión a MongoDB (usá una base nueva para Luz Serena, no la de otro cliente).
#   Local:  mongodb://127.0.0.1:27017/luzserena
#   Atlas:  mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/luzserena
MONGODB_URI=mongodb://127.0.0.1:27017/luzserena

# Clave para firmar las sesiones del panel. Poné un texto largo y al azar
# (por ejemplo, el resultado de: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambiame-por-un-texto-largo-y-secreto

# Puerto del servidor (en desarrollo la página lo usa a través de Vite)
PORT=3001
